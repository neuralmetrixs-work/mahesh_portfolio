---
// Experience.astro
const experiences = [
  {
    company: "Chimera Technologies",
    role: "Consultant",
    period: "April 2026 – Present",
    location: "Bengaluru, India",
    isCurrent: true,
    summary: "Leading an enterprise Customer Data Platform (CDP) implementation for a global pharmaceutical client. Architecting Customer 360, identity resolution strategies, and omnichannel campaign enablement."
  },
  {
    company: "Infocepts",
    role: "Senior Executive, Senior CDP Engineer",
    period: "October 2024 – March 2026",
    location: "Pune, India",
    isCurrent: false,
    summary: "Integrated multi-source marketing data into Treasure Data CDP. Built master audience segments and activation workflows across Klaviyo, AMC, SFMC, Pipedrive, and Oracle Eloqua."
  },
  {
    company: "Course5 Intelligence",
    role: "Senior Analyst, Senior Data Engineer",
    period: "January 2022 – October 2024",
    location: "Mumbai, India",
    isCurrent: false,
    summary: "Designed and optimized large-scale ETL pipelines using Python and SQL, cutting processing duration from 6–7 hours down to 2.5 hours. Automated cloud data workflows on AWS and Azure."
  }
];
---

<section id="experience" class="experience-section" aria-label="Career Experience">
  <div class="container">
    <div class="section-eyebrow">04 / EXPERIENCE</div>
    <h2 class="section-heading">Professional experience.</h2>

    <div class="timeline">
      {experiences.map((item) => (
        <article class={`timeline-item ${item.isCurrent ? 'current' : ''}`}>
          <div class="timeline-period-col">
            <span class="period-text">{item.period}</span>
            {item.isCurrent && (
              <span class="current-badge">
                <span class="pulse-dot"></span>
                <span>PRESENT</span>
              </span>
            )}
          </div>

          <div class="timeline-node" aria-hidden="true">
            <div class="node-dot"></div>
          </div>

          <div class="timeline-content-col">
            <div class="company-header">
              <h3 class="company-name">{item.company}</h3>
              <span class="role-location">{item.location}</span>
            </div>
            <div class="role-title">{item.role}</div>
            <p class="role-summary">{item.summary}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .experience-section {
    position: relative;
    background-color: var(--color-bg);
    padding: var(--section-spacing-y) 0;
    border-top: 1px solid var(--color-border);
  }

  .timeline {
    position: relative;
    margin-top: 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    position: relative;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 860px) {
    .timeline-item {
      grid-template-columns: 240px 40px 1fr;
      gap: 2rem;
      align-items: baseline;
      padding-bottom: 3rem;
    }
  }

  /* Period Column */
  .timeline-period-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .period-text {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.04em;
  }

  .current-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color-red);
    background-color: rgba(241, 10, 18, 0.08);
    border: 1px solid var(--color-border-red);
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
    width: fit-content;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-red);
    box-shadow: 0 0 8px var(--color-red);
  }

  /* Timeline Node */
  .timeline-node {
    display: none;
  }

  @media (min-width: 860px) {
    .timeline-node {
      display: flex;
      justify-content: center;
      position: relative;
      height: 100%;
    }

    .node-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background-color: var(--color-surface);
      border: 2px solid var(--color-border-hover);
      margin-top: 0.4rem;
      transition: background-color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
    }

    .timeline-item.current .node-dot {
      background-color: var(--color-red);
      border-color: var(--color-red);
      box-shadow: 0 0 12px var(--color-red);
    }

    .timeline-item:hover .node-dot {
      border-color: var(--color-red);
      transform: scale(1.3);
    }
  }

  /* Content Column */
  .timeline-content-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .company-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .company-name {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 2.75vw, 2.75rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--color-text-primary);
    transition: color var(--transition-fast);
  }

  .timeline-item:hover .company-name {
    color: var(--color-red);
  }

  .role-location {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .role-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: #FFFFFF;
    margin-bottom: 0.5rem;
  }

  .role-summary {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 680px;
  }
</style>
