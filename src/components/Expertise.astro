---
// Expertise.astro
const expertiseItems = [
  {
    num: "01",
    title: "Customer Data Platforms",
    description: "Enterprise CDP deployment, custom data modeling, golden record definition, and real-time behavioral data ingestion.",
    tags: ["Treasure Data CDP", "Data Modeling", "Ingestion"]
  },
  {
    num: "02",
    title: "Customer 360 & Identity Resolution",
    description: "Deterministic & probabilistic identity stitching across online and offline touchpoints to build unified customer profiles.",
    tags: ["Identity Graphs", "Profile Unification", "Golden Records"]
  },
  {
    num: "03",
    title: "Audience Segmentation & Activation",
    description: "Multi-layered rule-based and predictive cohort building, omnichannel campaign orchestration, and automated syndication.",
    tags: ["Omnichannel", "Cohort Modeling", "Syndication"]
  },
  {
    num: "04",
    title: "SQL & Python",
    description: "High-performance SQL query design, data transformation logic, automated Python orchestration scripts, and validation routines.",
    tags: ["Query Tuning", "Automation", "PySpark / Pandas"]
  },
  {
    num: "05",
    title: "ETL / ELT Pipelines",
    description: "Resilient batch and event-driven data pipeline architecture, data cleansing, automated monitoring, and throughput optimization.",
    tags: ["Pipeline Design", "Performance SLA", "Data Quality"]
  },
  {
    num: "06",
    title: "AWS & Azure Cloud",
    description: "Scalable cloud data infrastructure leveraging Amazon S3, EC2, Azure Data Factory (ADF), Azure Data Lake Storage (ADLS), and BigQuery.",
    tags: ["AWS S3/EC2", "Azure Data Factory", "BigQuery"]
  },
  {
    num: "07",
    title: "Marketing Technology Integration",
    description: "End-to-end integration across enterprise MarTech stacks including AMC, SFMC, Oracle Eloqua, Klaviyo, and Pipedrive.",
    tags: ["MarTech Stacks", "API Integrations", "Campaign Tools"]
  }
];

const toolsList = [
  "Treasure Data",
  "Amazon Marketing Cloud",
  "Salesforce Marketing Cloud",
  "Oracle Eloqua",
  "Klaviyo",
  "Pipedrive",
  "SQL",
  "Python",
  "AWS (S3, EC2)",
  "Azure (ADF, ADLS)",
  "BigQuery",
  "Git & GitHub",
  "DBeaver"
];
---

<section id="expertise" class="expertise-section" aria-label="Core Expertise and Technologies">
  <div class="container">
    <div class="section-eyebrow">02 / EXPERTISE</div>
    <h2 class="section-heading">What I work with.</h2>

    <!-- Typographic Editorial List -->
    <div class="expertise-list" role="list">
      {expertiseItems.map((item) => (
        <article class="expertise-row" role="listitem">
          <div class="row-num" aria-hidden="true">{item.num}</div>
          <div class="row-content">
            <h3 class="row-title">{item.title}</h3>
            <p class="row-desc">{item.description}</p>
          </div>
          <div class="row-tags" aria-label="Related areas">
            {item.tags.map((tag) => (
              <span class="row-tag-pill">{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>

    <!-- Integrated Tools & Platforms -->
    <div class="tools-container">
      <div class="tools-header">
        <span class="tools-eyebrow">TOOLS & PLATFORMS</span>
        <div class="tools-separator" aria-hidden="true"></div>
      </div>
      <div class="tools-grid">
        {toolsList.map((tool) => (
          <div class="tool-chip">
            <span class="tool-dot" aria-hidden="true"></span>
            <span class="tool-name">{tool}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .expertise-section {
    position: relative;
    background-color: var(--color-bg);
    padding: var(--section-spacing-y) 0;
    border-top: 1px solid var(--color-border);
  }

  .expertise-list {
    display: flex;
    flex-direction: column;
    margin-top: 3.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .expertise-row {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1.5rem;
    padding: 2.5rem 0;
    border-top: 1px solid var(--color-border);
    position: relative;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  @media (min-width: 900px) {
    .expertise-row {
      grid-template-columns: 5rem 1.8fr 1.2fr;
      align-items: baseline;
      padding: 2.75rem 1.5rem;
      margin-inline: -1.5rem;
      border-radius: 2px;
    }

    .expertise-row:hover {
      background-color: var(--color-surface);
      border-top-color: var(--color-border-hover);
    }

    .expertise-row::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 3px;
      background-color: var(--color-red);
      opacity: 0;
      transform: scaleY(0.4);
      transition: opacity var(--transition-fast), transform var(--transition-fast);
    }

    .expertise-row:hover::before {
      opacity: 1;
      transform: scaleY(1);
    }

    .expertise-row:hover .row-title {
      color: #FFFFFF;
      transform: translateX(6px);
    }
  }

  .row-num {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-red);
    letter-spacing: 0.1em;
    padding-top: 0.35rem;
  }

  .row-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .row-title {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.2vw, 3rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--color-text-primary);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .row-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 620px;
  }

  .row-tags {
    display: none;
  }

  @media (min-width: 900px) {
    .row-tags {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 0.5rem;
      padding-top: 0.35rem;
    }
  }

  .row-tag-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-border-subtle);
    padding: 0.35rem 0.75rem;
    border-radius: 2px;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .expertise-row:hover .row-tag-pill {
    color: var(--color-text-secondary);
    border-color: var(--color-border);
  }

  /* Tools & Platforms Section */
  .tools-container {
    margin-top: 6rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--color-border);
  }

  .tools-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.25rem;
  }

  .tools-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--color-text-muted);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .tools-separator {
    width: 100%;
    height: 1px;
    background-color: var(--color-border-subtle);
  }

  .tools-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .tool-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.75rem 1.35rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    transition: background-color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
  }

  .tool-chip:hover {
    background-color: var(--color-surface-hover);
    border-color: var(--color-border-red);
    transform: translateY(-2px);
  }

  .tool-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-red);
    opacity: 0.7;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .tool-chip:hover .tool-dot {
    opacity: 1;
    transform: scale(1.3);
  }

  .tool-name {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-primary);
    letter-spacing: 0.01em;
  }

  /* Mobile responsive */
  @media (max-width: 640px) {
    .expertise-row {
      grid-template-columns: 3rem 1fr;
      gap: 1rem;
      padding: 2rem 0;
    }
    .row-title {
      font-size: 1.75rem;
    }
    .tool-chip {
      padding: 0.6rem 1rem;
    }
  }
</style>
