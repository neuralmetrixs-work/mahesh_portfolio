---
// Projects.astro
---

<section id="work" class="work-section" aria-label="Selected Projects and Case Studies">
  <div class="container">
    <div class="work-header">
      <div>
        <div class="section-eyebrow">03 / SELECTED WORK</div>
        <h2 class="section-heading">Selected work.</h2>
      </div>
      <p class="work-subtitle">
        Architecting robust data foundations, unifying fragmented identities, and optimizing high-throughput marketing pipelines.
      </p>
    </div>

    <div class="projects-list">
      <!-- Project 01 -->
      <article class="project-card">
        <div class="project-info">
          <div class="project-meta">
            <span class="project-index">01</span>
            <span class="project-category">ENTERPRISE ARCHITECTURE</span>
          </div>
          <h3 class="project-title">Enterprise CDP Implementation</h3>
          <p class="project-summary">
            Customer data integration, identity resolution, unified profiles and audience activation for an enterprise pharmaceutical client.
          </p>
          <div class="project-tags">
            <span class="tag">Treasure Data CDP</span>
            <span class="tag">Customer 360</span>
            <span class="tag">Identity Resolution</span>
            <span class="tag">Omnichannel Activation</span>
          </div>
        </div>

        <div class="project-visual-wrapper" aria-hidden="true">
          <div class="project-visual technical-visual-1">
            <!-- Abstract Customer 360 / Identity Graph Illustration -->
            <svg class="tech-svg" viewBox="0 0 540 320" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="cdpGlow" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#F10A12" stop-opacity="0.3"/>
                  <stop offset="100%" stop-color="#F10A12" stop-opacity="0"/>
                </linearGradient>
              </defs>
              <!-- Grid Matrix -->
              <path d="M40 40H500M40 100H500M40 160H500M40 220H500M40 280H500" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
              <path d="M100 40V280M200 40V280M300 40V280M400 40V280" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
              
              <!-- Identity Connection Lines -->
              <path d="M110 90L270 160M110 230L270 160M430 90L270 160M430 230L270 160" stroke="rgba(255,255,255,0.15)" stroke-width="1.5" stroke-dasharray="4 4"/>
              
              <!-- Source Nodes -->
              <circle cx="110" cy="90" r="18" fill="#121216" stroke="rgba(255,255,255,0.2)" stroke-width="1.5"/>
              <text x="110" y="94" font-family="monospace" font-size="9" fill="#9A9A9E" text-anchor="middle">CRM</text>

              <circle cx="110" cy="230" r="18" fill="#121216" stroke="rgba(255,255,255,0.2)" stroke-width="1.5"/>
              <text x="110" y="234" font-family="monospace" font-size="9" fill="#9A9A9E" text-anchor="middle">WEB</text>

              <circle cx="430" cy="90" r="18" fill="#121216" stroke="rgba(255,255,255,0.2)" stroke-width="1.5"/>
              <text x="430" y="94" font-family="monospace" font-size="9" fill="#9A9A9E" text-anchor="middle">OFFLINE</text>

              <circle cx="430" cy="230" r="18" fill="#121216" stroke="rgba(255,255,255,0.2)" stroke-width="1.5"/>
              <text x="430" y="234" font-family="monospace" font-size="9" fill="#9A9A9E" text-anchor="middle">EVENT</text>

              <!-- Central Golden Record Hub -->
              <circle cx="270" cy="160" r="48" fill="#141418" stroke="#F10A12" stroke-width="2"/>
              <circle cx="270" cy="160" r="38" fill="url(#cdpGlow)"/>
              <circle cx="270" cy="160" r="6" fill="#F10A12"/>
              <text x="270" y="152" font-family="monospace" font-size="10" font-weight="bold" fill="#FFFFFF" text-anchor="middle">CUSTOMER 360</text>
              <text x="270" y="174" font-family="monospace" font-size="8" fill="#F10A12" text-anchor="middle">GOLDEN ID</text>
            </svg>
          </div>
        </div>
      </article>

      <!-- Project 02 -->
      <article class="project-card">
        <div class="project-info">
          <div class="project-meta">
            <span class="project-index">02</span>
            <span class="project-category">MARKETING SYSTEMS INTEGRATION</span>
          </div>
          <h3 class="project-title">Marketing Data Integration</h3>
          <p class="project-summary">
            Integrated marketing data sources and developed audience segmentation and activation workflows using Treasure Data CDP and connected marketing platforms.
          </p>
          <div class="project-tags">
            <span class="tag">AMC & SFMC</span>
            <span class="tag">Oracle Eloqua</span>
            <span class="tag">Klaviyo</span>
            <span class="tag">Pipedrive</span>
            <span class="tag">Cohort Workflows</span>
          </div>
        </div>

        <div class="project-visual-wrapper" aria-hidden="true">
          <div class="project-visual technical-visual-2">
            <!-- Abstract MarTech Ingestion & Orchestration Graph -->
            <svg class="tech-svg" viewBox="0 0 540 320" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Stream Flow Paths -->
              <path d="M60 160 C150 160, 160 80, 260 80 C360 80, 380 120, 480 120" stroke="rgba(255,255,255,0.12)" stroke-width="2"/>
              <path d="M60 160 C150 160, 180 160, 270 160 C360 160, 390 160, 480 160" stroke="#F10A12" stroke-width="2.5"/>
              <path d="M60 160 C150 160, 160 240, 260 240 C360 240, 380 200, 480 200" stroke="rgba(255,255,255,0.12)" stroke-width="2"/>

              <!-- Central CDP Processing Junction -->
              <rect x="220" y="132" width="100" height="56" rx="4" fill="#141418" stroke="#F10A12" stroke-width="1.5"/>
              <text x="270" y="156" font-family="monospace" font-size="9" font-weight="bold" fill="#FFFFFF" text-anchor="middle">TREASURE DATA</text>
              <text x="270" y="172" font-family="monospace" font-size="8" fill="#9A9A9E" text-anchor="middle">SEGMENTATION</text>

              <!-- Ingestion Hub Left -->
              <rect x="50" y="142" width="70" height="36" rx="4" fill="#0F0F12" stroke="rgba(255,255,255,0.2)" stroke-width="1.5"/>
              <text x="85" y="164" font-family="monospace" font-size="9" fill="#FFFFFF" text-anchor="middle">SOURCES</text>

              <!-- Destination Endpoints Right -->
              <g transform="translate(430, 95)">
                <rect width="80" height="26" rx="3" fill="#0F0F12" stroke="rgba(255,255,255,0.15)"/>
                <text x="40" y="17" font-family="monospace" font-size="8" fill="#9A9A9E" text-anchor="middle">AMC / SFMC</text>
              </g>
              <g transform="translate(430, 147)">
                <rect width="80" height="26" rx="3" fill="#0F0F12" stroke="var(--color-border-red)"/>
                <text x="40" y="17" font-family="monospace" font-size="8" fill="#FFFFFF" text-anchor="middle">KLAVIYO</text>
              </g>
              <g transform="translate(430, 199)">
                <rect width="80" height="26" rx="3" fill="#0F0F12" stroke="rgba(255,255,255,0.15)"/>
                <text x="40" y="17" font-family="monospace" font-size="8" fill="#9A9A9E" text-anchor="middle">ELOQUA</text>
              </g>
            </svg>
          </div>
        </div>
      </article>

      <!-- Project 03 (ETL Pipeline Optimization with Visually Prominent Metric) -->
      <article class="project-card featured-metric-card">
        <div class="project-info">
          <div class="project-meta">
            <span class="project-index">03</span>
            <span class="project-category">PERFORMANCE & DATA ENGINEERING</span>
          </div>
          <h3 class="project-title">ETL Pipeline Optimization</h3>
          <p class="project-summary">
            Reduced data processing time from 6–7 hours to approximately 2.5 hours using Python and SQL.
          </p>
          
          <!-- Visually Prominent Performance Metric Display -->
          <div class="metric-highlight-box">
            <div class="metric-comparison">
              <div class="metric-col">
                <span class="metric-label">BEFORE</span>
                <span class="metric-val muted">6–7h</span>
              </div>
              <div class="metric-arrow" aria-hidden="true">→</div>
              <div class="metric-col">
                <span class="metric-label">OPTIMIZED</span>
                <span class="metric-val accent">2.5h</span>
              </div>
            </div>
            <div class="metric-pill">
              <span class="pill-dot"></span>
              <span>~60% RUNTIME REDUCTION</span>
            </div>
          </div>

          <div class="project-tags">
            <span class="tag">Python</span>
            <span class="tag">SQL Query Tuning</span>
            <span class="tag">ETL Optimization</span>
            <span class="tag">SLA Acceleration</span>
          </div>
        </div>

        <div class="project-visual-wrapper" aria-hidden="true">
          <div class="project-visual technical-visual-3">
            <!-- Abstract Batch Processing Runtime Comparison Chart -->
            <svg class="tech-svg" viewBox="0 0 540 320" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Grid -->
              <line x1="60" y1="250" x2="480" y2="250" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
              <line x1="60" y1="70" x2="60" y2="250" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
              
              <!-- Timeline Axis labels -->
              <text x="60" y="272" font-family="monospace" font-size="9" fill="#5C5C60">0h</text>
              <text x="210" y="272" font-family="monospace" font-size="9" fill="#F10A12" font-weight="bold">2.5h (Current)</text>
              <text x="460" y="272" font-family="monospace" font-size="9" fill="#5C5C60">7.0h (Legacy)</text>

              <!-- Legacy Pipeline Bar -->
              <text x="60" y="105" font-family="monospace" font-size="10" fill="#9A9A9E">LEGACY BATCH PIPELINE</text>
              <rect x="60" y="115" width="410" height="32" rx="3" fill="#18181E" stroke="rgba(255,255,255,0.1)"/>
              <text x="455" y="136" font-family="monospace" font-size="11" font-weight="bold" fill="#71717A" text-anchor="end">6–7 HOURS</text>

              <!-- Optimized Pipeline Bar -->
              <text x="60" y="185" font-family="monospace" font-size="10" fill="#FFFFFF">OPTIMIZED SQL & PYTHON PIPELINE</text>
              <rect x="60" y="195" width="165" height="36" rx="3" fill="#F10A12"/>
              <text x="210" y="218" font-family="monospace" font-size="12" font-weight="bold" fill="#FFFFFF" text-anchor="end">2.5H</text>

              <!-- Delta Marker -->
              <line x1="225" y1="180" x2="470" y2="180" stroke="#F10A12" stroke-width="1.5" stroke-dasharray="3 3"/>
              <text x="347" y="174" font-family="monospace" font-size="9" font-weight="bold" fill="#F10A12" text-anchor="middle">-4.2 HOURS SAVED DAILY</text>
            </svg>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .work-section {
    position: relative;
    background-color: var(--color-bg);
    padding: var(--section-spacing-y) 0;
    border-top: 1px solid var(--color-border);
  }

  .work-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 4.5rem;
  }

  @media (min-width: 992px) {
    .work-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }

    .work-subtitle {
      max-width: 480px;
      font-size: 1.0625rem;
      line-height: 1.6;
      color: var(--color-text-secondary);
      margin-bottom: 2.5rem;
    }
  }

  .work-subtitle {
    color: var(--color-text-secondary);
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .project-card {
    display: grid;
    grid-template-columns: 1fr;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
    transition: border-color var(--transition-base), transform var(--transition-base);
  }

  @media (min-width: 992px) {
    .project-card {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
      min-height: 400px;
    }

    .project-card:hover {
      border-color: var(--color-border-hover);
      transform: translateY(-3px);
    }
  }

  .project-info {
    padding: clamp(2rem, 4vw, 3.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .project-index {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-red);
  }

  .project-category {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .project-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.2vw, 3.25rem);
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: 1.25rem;
  }

  .project-summary {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border-subtle);
    padding: 0.35rem 0.75rem;
    border-radius: 2px;
  }

  /* Visual Container */
  .project-visual-wrapper {
    background-color: #0c0c0e;
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 992px) {
    .project-visual-wrapper {
      border-top: none;
      border-left: 1px solid var(--color-border);
      padding: 2.5rem;
    }
  }

  .project-visual {
    width: 100%;
    max-width: 500px;
    height: auto;
    transition: transform var(--transition-base);
  }

  .project-card:hover .project-visual {
    transform: scale(1.02);
  }

  .tech-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Metric Highlight Box for Project 03 */
  .metric-highlight-box {
    margin-bottom: 2rem;
    padding: 1.5rem;
    background-color: rgba(241, 10, 18, 0.06);
    border: 1px solid var(--color-border-red);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .metric-comparison {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }

  .metric-col {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .metric-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .metric-val {
    font-family: var(--font-display);
    font-size: 2.5rem;
    line-height: 0.9;
    letter-spacing: 0.02em;
  }

  .metric-val.muted {
    color: var(--color-text-muted);
    text-decoration: line-through;
    opacity: 0.75;
  }

  .metric-val.accent {
    color: var(--color-red);
  }

  .metric-arrow {
    font-size: 1.75rem;
    color: var(--color-red);
    align-self: center;
  }

  .metric-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: #FFFFFF;
    letter-spacing: 0.08em;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    background-color: var(--color-red);
    border-radius: 50%;
  }
</style>
