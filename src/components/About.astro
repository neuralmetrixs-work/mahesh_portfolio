---
// About.astro
---

<section id="about" class="about-section" aria-label="About Mahesh Gadakh">
  <div class="container">
    <div class="about-eyebrow-wrapper">
      <span class="section-eyebrow">01 / ABOUT ME</span>
    </div>

    <div class="about-grid">
      <!-- Left Column: Editorial Headline & Experience Badge -->
      <div class="about-left-col">
        <h2 class="about-headline">
          Customer data platforms, marketing systems and data pipelines.
        </h2>

        <div class="about-experience-badge">
          <span class="badge-dot" aria-hidden="true"></span>
          <span class="badge-text">4.6 YEARS OF EXPERIENCE</span>
        </div>
      </div>

      <!-- Right Column: Editorial Body & Precision Scope -->
      <div class="about-right-col">
        <p class="about-body">
          I work with customer data platforms, marketing systems and data pipelines. My experience includes building CDP solutions, integrating customer data, developing audience segments and optimizing ETL workflows.
        </p>

        <div class="about-details-list">
          <div class="detail-item">
            <span class="detail-label">CORE FOCUS</span>
            <span class="detail-value">Customer 360, Identity Resolution & Omnichannel Activation</span>
          </div>
          <div class="detail-item">
            <span class="detail-label">SPECIALIZATION</span>
            <span class="detail-value">Enterprise Treasure Data CDP, Cloud Data Warehouses & Pipeline Architecture</span>
          </div>
          <div class="detail-item">
            <span class="detail-label">LOCATION</span>
            <span class="detail-value">India · Available for Global Enterprise Engagements</span>
          </div>
        </div>

        <div class="about-cta-row">
          <a href="#work" class="btn-secondary">
            <span>Explore Selected Work</span>
            <span class="arrow" aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    position: relative;
    background-color: var(--color-bg);
    padding: var(--section-spacing-y) 0;
    border-top: 1px solid var(--color-border-subtle);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    margin-top: 2rem;
  }

  @media (min-width: 992px) {
    .about-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 5.5rem;
      align-items: start;
    }
  }

  /* Left Column */
  .about-headline {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5.2vw, 5.5rem);
    line-height: 0.94;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: 2.75rem;
  }

  .about-experience-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1.15rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 2px;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-red);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--color-red);
  }

  .badge-text {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color-text-primary);
  }

  /* Right Column */
  .about-body {
    font-size: clamp(1.125rem, 1.45vw, 1.35rem);
    line-height: 1.65;
    color: var(--color-text-secondary);
    font-weight: 400;
    margin-bottom: 3rem;
  }

  .about-details-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    margin-bottom: 3rem;
  }

  .detail-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .detail-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--color-red);
    text-transform: uppercase;
  }

  .detail-value {
    font-size: 0.95rem;
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .about-cta-row {
    display: flex;
    align-items: center;
  }

  .arrow {
    display: inline-block;
    transition: transform var(--transition-fast);
  }

  .btn-secondary:hover .arrow {
    transform: translateY(3px);
  }
</style>
