---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Mahesh Gadakh — Customer Data Platform Specialist & Data Engineer",
  description = "Official portfolio of Mahesh Gadakh. Customer Data Platform (CDP) Specialist, Marketing Technology Consultant, and Data Engineer with 4.6+ years of enterprise experience."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://maheshgadakh.pages.dev");
const ogImageURL = new URL("/images/Red-Rimmed%20Monochrome%20Portrait.png", canonicalURL);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Mahesh Gadakh" />
    <meta name="keywords" content="Mahesh Gadakh, Customer Data Platform, CDP Specialist, Marketing Technology, MarTech, Data Engineer, Treasure Data, AWS, Azure, SQL, Python" />
    <meta name="theme-color" content="#F10A12" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />

    <!-- Preload Critical Assets (LCP Optimization) -->
    <!-- Local Bebas Neue & Anton: preloaded so hero font is available immediately on first paint with zero swap/flash -->
    <link rel="preload" href="/fonts/bebas-neue.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/anton.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" />
    <link rel="preload" as="image" href="/images/Red-Rimmed%20Monochrome%20Portrait.png" fetchpriority="high" type="image/png" />


    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
